# Copy to .env and fill in. Compose refuses to start while a required value is empty.
NEXTCLOUD_ADMIN_USER=
NEXTCLOUD_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# The OpenRegister version {{appName}} was built on.
OPENREGISTER_VERSION={{openregisterVersion}}

# Optional.
NEXTCLOUD_VERSION={{nextcloudVersion}}
PORT=8080
TRUSTED_DOMAINS=localhost
