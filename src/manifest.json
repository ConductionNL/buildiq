{
	"$schema": "https://codeberg.org/Conduction/nextcloud-vue/raw/branch/main/src/schemas/app-manifest-v2.schema.json",
	"version": "2.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "VirtualApps",
			"label": "Virtual apps",
			"icon": "icon-category-app-bundles",
			"route": "VirtualApps",
			"order": 20
		},
		{
			"id": "Schemas",
			"label": "Schemas",
			"icon": "icon-category-customization",
			"route": "Schemas",
			"order": 30
		},
		{
			"id": "Templates",
			"label": "Templates",
			"icon": "icon-category-organization",
			"route": "Templates",
			"order": 35
		},
		{
			"id": "Exports",
			"label": "Exports",
			"icon": "icon-download",
			"route": "Exports",
			"order": 40
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://openbuild.conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 95
		}
	],
	"pages": [
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "App development overview",
			"slots": {
				"widget-recent-apps": "DashboardAppsListWidget"
			},
			"config": {
				"description": "Build, manage and publish virtual applications on OpenRegister",
				"documentationUrl": "https://openbuild.conduction.nl",
				"widgets": [
					{
						"id": "kpi-virtual-apps",
						"title": "Virtual apps",
						"type": "stats-block",
						"iconClass": "icon-category-app-bundles",
						"props": { "countLabel": "apps", "variant": "primary" },
						"dataSource": {
							"register": "openbuild",
							"schema": "application",
							"aggregate": "count"
						}
					},
					{
						"id": "kpi-published",
						"title": "Published",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"props": { "countLabel": "live", "variant": "success" },
						"dataSource": {
							"register": "openbuild",
							"schema": "builtAppRoute",
							"aggregate": "count"
						}
					},
					{
						"id": "kpi-templates",
						"title": "Templates",
						"type": "stats-block",
						"iconClass": "icon-category-organization",
						"props": { "countLabel": "templates", "variant": "default" },
						"dataSource": {
							"register": "openbuild",
							"schema": "applicationTemplate",
							"aggregate": "count"
						}
					},
					{
						"id": "kpi-versions",
						"title": "Published versions",
						"type": "stats-block",
						"iconClass": "icon-history",
						"props": { "countLabel": "snapshots", "variant": "default" },
						"dataSource": {
							"register": "openbuild",
							"schema": "applicationVersion",
							"aggregate": "count"
						}
					},
					{
						"id": "recent-apps",
						"title": "Virtual apps",
						"type": "custom",
						"iconClass": "icon-category-app-bundles"
					}
				],
				"layout": [
					{
						"id": "layout-kpi-virtual-apps",
						"widgetId": "kpi-virtual-apps",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": true
					},
					{
						"id": "layout-kpi-published",
						"widgetId": "kpi-published",
						"gridX": 3,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": true
					},
					{
						"id": "layout-kpi-templates",
						"widgetId": "kpi-templates",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": true
					},
					{
						"id": "layout-kpi-versions",
						"widgetId": "kpi-versions",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2,
						"showTitle": true
					},
					{
						"id": "layout-recent-apps",
						"widgetId": "recent-apps",
						"gridX": 0,
						"gridY": 2,
						"gridWidth": 12,
						"gridHeight": 6
					}
				]
			}
		},
		{
			"id": "VirtualApps",
			"route": "/applications",
			"type": "index",
			"title": "Virtual apps",
			"actionsComponent": "VirtualAppsActions",
			"config": {
				"register": "openbuild",
				"schema": "application",
				"viewMode": "cards",
				"cardComponent": "ApplicationCard",
				"columns": [
					"name",
					"status",
					"version",
					"@self.updated"
				],
				"showAdd": false,
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			}
		},
		{
			"id": "VirtualAppDetail",
			"route": "/applications/:objectId",
			"type": "detail",
			"title": "Virtual app",
			"headerComponent": "ApplicationDetailHeader",
			"actionsComponent": "ApplicationDetailActions",
			"config": {
				"register": "openbuild",
				"schema": "application",
				"sidebarTabs": [
					{
						"id": "manifest",
						"label": "Manifest",
						"icon": "icon-edit",
						"component": "ApplicationManifestTab",
						"order": 20
					},
					{
						"id": "history",
						"label": "Version history",
						"icon": "icon-history",
						"component": "ApplicationVersionsTab",
						"order": 30
					},
					{
						"id": "diff",
						"label": "Diff",
						"icon": "icon-files",
						"component": "ApplicationDiffTab",
						"order": 40
					},
					{
						"id": "icons",
						"label": "Icons",
						"icon": "icon-image",
						"component": "ApplicationIconTab",
						"order": 50
					},
					{
						"id": "exports",
						"label": "Exports",
						"icon": "icon-download",
						"component": "ExportJobsTab",
						"order": 60
					}
				],
				"documentationUrl": "https://openbuild.conduction.nl"
			},
			"widgets": [
				{
					"widgetKey": "audit-trail",
					"slot": "sidebar",
					"tabGroup": "audit",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 1,
					"gridHeight": 1
				}
			]
		},
		{
			"id": "Schemas",
			"route": "/schemas",
			"type": "detail",
			"title": "Schemas",
			"slots": {
				"default": "SchemaDesignerView"
			},
			"config": {
				"register": "openbuild",
				"schema": "application",
				"sidebar": {
					"enabled": false
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			},
			"_note": "Top-level schemas overview \u2014 renders the SchemaDesignerView (list mode) via the registry-backed `slots.default` override so the primary action is the native \"Add schema\" flow (SchemaListPanel + AddSchemaDialog). Previously this page was type:\"index\" and fell through to the generic CnIndexPage, which keys its Add button off config.schema (\"application\") and so mislabelled the action \"Add Application\". A type:\"custom\" + top-level `component` does NOT resolve here because CnPageRenderer (beta.107) dispatches custom pages via the empty legacy customComponents map, not the v2 registry; the slot-override path (resolvedSlotEntries) is the one that reads cnRegistry. With no :schemaId route param SchemaDesignerView renders list mode and the no-slug /schemas shortcut falls back to the hello-world app. Per-app drill-down lives under /builder/:slug/schemas."
		},
		{
			"id": "Templates",
			"route": "/templates",
			"type": "index",
			"title": "Templates",
			"config": {
				"register": "openbuild",
				"schema": "application-template",
				"viewMode": "cards",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			}
		},
		{
			"id": "SchemaDesignerList",
			"route": "/builder/:slug/schemas",
			"type": "index",
			"title": "Schemas",
			"config": {
				"register": "openbuild",
				"schema": "application",
				"viewMode": "cards",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			},
			"_note": "Per-app schema list under the builder route. Scoped to the virtual app identified by :slug — the index page type's filter wiring kicks in via the route param."
		},
		{
			"id": "SchemaDesigner",
			"route": "/builder/:slug/schemas/:schemaId",
			"type": "detail",
			"title": "Schema",
			"config": {
				"register": "openbuild",
				"schema": "application",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			},
			"slots": {
				"default": "SchemaDesignerView"
			}
		},
		{
			"id": "PageDesigner",
			"route": "/builder/:slug/pages",
			"type": "detail",
			"title": "Page designer",
			"config": {
				"register": "openbuild",
				"schema": "application",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			},
			"slots": {
				"default": "PageDesignerView"
			}
		},
		{
			"id": "Exports",
			"route": "/exports",
			"type": "index",
			"title": "Exports",
			"config": {
				"register": "openbuild",
				"schema": "export-job",
				"viewMode": "table",
				"sidebar": {
					"enabled": true,
					"showMetadata": true
				},
				"documentationUrl": "https://openbuild.conduction.nl"
			}
		},
		{
			"id": "BuilderHost",
			"route": "/builder/:slug/:pathMatch(.*)?",
			"type": "custom",
			"title": "Virtual app",
			"component": "BuilderHostView",
			"_note": "Virtual-app host that mounts a nested CnAppRoot rendering the virtual app's own manifest from GET /api/applications/{slug}/manifest. This is a meta-app-shell (app inside app) pattern that no standard page type supports. It is the core runtime surface of openbuild and will always require a custom host component."
		},
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://openbuild.conduction.nl"
			}
		}
	]
}
