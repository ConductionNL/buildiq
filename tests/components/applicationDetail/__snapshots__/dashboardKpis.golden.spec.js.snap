exports[`ApplicationDetailDashboard KPI row > renders the loading cards without a register 1`] = `
"<div class="ob-detail-dashboard__kpis">
  <a class="ob-detail-dashboard__kpi-link">
    <!--v-if-->
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Active users" count="0" countlabel="users" variant="primary" loading="true" loadinglabel="Loading…" showzerocount="false"></cnstatsblock>
  </a><a class="ob-detail-dashboard__kpi-link">
    <!--v-if-->
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Object count" count="0" countlabel="objects" variant="primary" loading="true" loadinglabel="Loading…" showzerocount="false"></cnstatsblock>
  </a>
  <a class="ob-detail-dashboard__kpi-link">
    <!--v-if-->
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Storage" count="0" variant="success" loading="" loadinglabel="Loading…"></cnstatsblock>
  </a><a class="ob-detail-dashboard__kpi-link">
    <!--v-if-->
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Audit events" count="0" countlabel="events" variant="warning" loading="true" loadinglabel="Loading…" showzerocount="false"></cnstatsblock>
  </a>
</div>"
`;
