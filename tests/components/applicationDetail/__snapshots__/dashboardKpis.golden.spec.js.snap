// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ApplicationDetailDashboard KPI row > renders the cards with an error 1`] = `
"<div class="ob-detail-dashboard__kpis">
  <a class="ob-detail-dashboard__kpi-link ob-detail-dashboard__kpi-link--clickable" href="/apps/openregister/registers/hello-world?tab=audit" title="Open in OpenRegister" aria-label="Open Active users in OpenRegister">
    <arrow-top-right-stub fillcolor="currentColor" size="16" class="ob-detail-dashboard__kpi-go" aria-hidden="true"></arrow-top-right-stub>
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Active users" count="3" countlabel="users" variant="primary" loading="false" loadinglabel="Loading…" showzerocount="true" error="boom"></cnstatsblock>
  </a><a class="ob-detail-dashboard__kpi-link ob-detail-dashboard__kpi-link--clickable" href="/apps/openregister/registers/hello-world?tab=objects" title="Open in OpenRegister" aria-label="Open Object count in OpenRegister">
    <arrow-top-right-stub fillcolor="currentColor" size="16" class="ob-detail-dashboard__kpi-go" aria-hidden="true"></arrow-top-right-stub>
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Object count" count="12" countlabel="objects" variant="primary" loading="false" loadinglabel="Loading…" showzerocount="true" error="boom"></cnstatsblock>
  </a>
  <a class="ob-detail-dashboard__kpi-link ob-detail-dashboard__kpi-link--clickable" href="/apps/openregister/registers/hello-world?tab=files" title="Open in OpenRegister" aria-label="Open Storage in OpenRegister">
    <arrow-top-right-stub fillcolor="currentColor" size="16" class="ob-detail-dashboard__kpi-go" aria-hidden="true"></arrow-top-right-stub>
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Storage" count="2048" countlabel="" variant="success" showzerocount=""></cnstatsblock>
  </a><a class="ob-detail-dashboard__kpi-link ob-detail-dashboard__kpi-link--clickable" href="/apps/openregister/registers/hello-world?tab=audit" title="Open in OpenRegister" aria-label="Open Audit events in OpenRegister">
    <arrow-top-right-stub fillcolor="currentColor" size="16" class="ob-detail-dashboard__kpi-go" aria-hidden="true"></arrow-top-right-stub>
    <cnstatsblock class="ob-detail-dashboard__kpi" horizontal="" icon="[object Object]" title="Audit events" count="7" countlabel="events" variant="warning" loading="false" loadinglabel="Loading…" showzerocount="true" error="boom"></cnstatsblock>
  </a>
</div>"
`;

