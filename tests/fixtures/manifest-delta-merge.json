	{
		"name": "a page is removed",
		"base": {
			"pages": [
				{
					"id": "home",
					"route": "/home"
				},
				{
					"id": "old",
					"route": "/old"
				}
			]
		},
		"delta": {
			"pages": [
				{
					"id": "old",
