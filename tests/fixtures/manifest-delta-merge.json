	{
		"name": "removing a missing page is an orphan",
		"base": {
			"pages": [
				{
					"id": "home",
					"route": "/home"
				}
			]
		},
		"delta": {
			"pages": [
				{
					"id": "gone",
					"$op": "remove"
				}
			]
		},
		"expected": {
			"manifest": {
				"pages": [
					{
						"id": "home",
						"route": "/home"
					}
				]
			},
			"orphanedDeltaPaths": [
				"pages/gone"
			]
		}
	},
	{
