	{
		"name": "__order reorders, unlisted entries follow",
		"base": {
			"pages": [
				{
					"id": "a",
					"route": "/a"
				},
				{
					"id": "b",
					"route": "/b"
				},
				{
					"id": "c",
					"route": "/c"
				}
			]
		},
		"delta": {
			"__order": {
				"pages": [
					"c",
					"a"
				]
			}
		},
		"expected": {
			"manifest": {
				"pages": [
					{
						"id": "c",
						"route": "/c"
					},
					{
						"id": "a",
						"route": "/a"
					},
					{
						"id": "b",
						"route": "/b"
					}
				]
			},
			"orphanedDeltaPaths": []
		}
	},
	{
		"name": "a nested __order inside a page entry applies",
		"base": {
			"pages": [
				{
					"id": "dash",
					"route": "/dash",
					"config": {
						"widgets": [
							{
								"id": "w1"
							},
							{
								"id": "w2"
							}
						],
						"__unused": 1
					}
				}
			]
		},
		"delta": {
			"pages": [
				{
					"id": "dash",
					"config": {
						"__order": {
							"widgets": [
								"w2",
								"w1"
							]
						}
					}
				}
			]
		},
		"expected": {
			"manifest": {
				"pages": [
					{
						"id": "dash",
						"route": "/dash",
						"config": {
							"widgets": [
								{
									"id": "w2"
								},
								{
									"id": "w1"
								}
							],
							"__unused": 1
						}
					}
				]
			},
			"orphanedDeltaPaths": []
		}
	},
