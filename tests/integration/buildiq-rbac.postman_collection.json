							"raw": "{{base_url}}/index.php/apps/buildiq/api/applications/{{test_slug}}/manifest",
							"host": ["{{base_url}}"],
							"path": ["index.php", "apps", "buildiq", "api", "applications", "{{test_slug}}", "manifest"]
						}
					},
					"event": [
