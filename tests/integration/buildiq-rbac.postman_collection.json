				{
					"name": "1.9 Locate the hello-world Application and patch permissions",
					"description": "Looks up the Application by slug via OR's REST search, captures its uuid into the collection variable `application_uuid`, then PUTs a `permissions` block that grants the viewer group viewer role and the editor group editor role. Owners stays `admin`.",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/index.php/apps/openregister/api/objects/buildiq/built-app?slug={{test_slug}}",
							"host": ["{{base_url}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "buildiq", "built-app"],
							"query": [
								{ "key": "slug", "value": "{{test_slug}}" }
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('OR returned the Application list', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"const body = pm.response.json();",
									"const rows = (body && body.results) || (Array.isArray(body) ? body : []);",
									"const app = rows.find(r => (r.slug === pm.collectionVariables.get('test_slug') || (r['@self'] && r['@self'].slug === pm.collectionVariables.get('test_slug'))));",
									"pm.test('hello-world Application present', function () {",
									"    pm.expect(app, 'expected to find the seeded hello-world Application').to.not.be.undefined;",
									"});",
									"if (app) {",
									"    const uuid = app.uuid || (app['@self'] && app['@self'].id) || app.id;",
									"    pm.collectionVariables.set('application_uuid', String(uuid));",
									"    // Stash the WHOLE record — the three permission PUTs below merge",
									"    // into it. OR's saveObject() is PUT-semantic and nulls every schema",
									"    // property the body omits; Application.required is ['slug','name'];",
									"    // so a bare {\"permissions\": {...}} body asked OR to null both",
									"    // required fields and was refused with 400 Bad request. Nothing in",
									"    // that failure mentions slug or name, so it read as an RBAC bug.",
									"    // `@self` is server-owned metadata, not writable state.",
									"    const full = JSON.parse(JSON.stringify(app));",
									"    delete full['@self'];",
									"    pm.collectionVariables.set('application_full', JSON.stringify(full));",
									"}"
								]
							}
						}
					]
				},
				{
					"name": "1.10 PUT permissions block (admin owner + viewer/editor groups)",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{merged_body}}"
						},
						"url": {
							"raw": "{{base_url}}/index.php/apps/openregister/api/objects/buildiq/built-app/{{application_uuid}}",
							"host": ["{{base_url}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "buildiq", "built-app", "{{application_uuid}}"]
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// TWO DEFECTS IN ONE BODY.",
									"//",
									"// (1) It was a bare {\"permissions\": {...}}. OR's saveObject() is",
									"//     PUT-semantic and nulls every schema property the body omits;",
									"//     Application.required is ['slug','name']; so OR refused the",
									"//     write with 400 and said nothing about slug or name. Three",
									"//     assertions failed on that — and the three that follow were",
									"//     then measuring an Application whose permissions had never",
									"//     been written at all.",
									"//",
									"// (2) The principals were BARE. PermissionResolver::matchesCaller()",
									"//     classifies principals by a `user:` / `group:` PREFIX. That is",
									"//     the grammar SeedHelloWorldFixture.php writes",
									"//     (owners: ['user:admin']) and the one appRoles.ts writes",
									"//     (editors: ['group:rbac-editors']). A bare \"admin\" or a bare",
									"//     group name matches nothing, so even a write that LANDED",
									"//     would have granted no one — and the later 'outsider' checks",
									"//     would still have been comparing against an app nobody could",
									"//     reach by role.",
									"const base = JSON.parse(pm.collectionVariables.get('application_full') || '{}');",
									"const permissions = {",
									"    owners: ['user:' + pm.collectionVariables.get('admin_user')],",
									"    editors: ['group:' + pm.collectionVariables.get('editor_group')],",
									"    viewers: ['group:' + pm.collectionVariables.get('viewer_group')]",
									"};",
									"pm.collectionVariables.set('merged_body', JSON.stringify(Object.assign({}, base, { permissions: permissions })));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Permissions block written', function () {",
									"    pm.expect(pm.response.code, pm.response.code === 400",
									"        ? 'got 400 — OR PUT is PUT-semantic, so a bare {permissions} body nulls the required slug/name; send the merged full record'",
									"        : 'the permissions write must be accepted').to.be.oneOf([200, 201, 204]);",
									"});",
									"// Assert the grant actually READ BACK, and in the prefixed grammar.",
									"// Without this the collection could go green on a write that landed",
									"// but granted nobody — which is exactly what the bare principals did.",
									"pm.test('the permissions read back with user:/group: principals', function () {",
									"    const body = pm.response.json();",
									"    const perms = (body && body.permissions) || {};",
									"    pm.expect(perms.owners, 'owners must carry a user:-prefixed principal').to.include('user:' + pm.collectionVariables.get('admin_user'));",
									"    pm.expect(perms.editors, 'editors must carry a group:-prefixed principal').to.include('group:' + pm.collectionVariables.get('editor_group'));",
									"    pm.expect(perms.viewers, 'viewers must carry a group:-prefixed principal').to.include('group:' + pm.collectionVariables.get('viewer_group'));",
									"});",
									"pm.test('slug and name survived the write (PUT semantics did not null them)', function () {",
									"    const base = JSON.parse(pm.collectionVariables.get('application_full') || '{}');",
									"    const body = pm.response.json();",
									"    pm.expect(body.slug).to.eql(base.slug);",
									"    pm.expect(body.name).to.eql(base.name);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "REQ-OBRBAC-003 — list-endpoint IDOR is closed",
			"description": "Validates ApplicationsController::listMine filters by per-Application permissions: viewer + editor see the seeded app, outsider sees an empty list. Failing this group surfaces the list-endpoint IDOR closed in commit 2389ec6.",
