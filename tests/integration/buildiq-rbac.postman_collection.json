		{
			"name": "REQ-OBRBAC-005 — owner-only transfer-ownership flow",
			"description": "Validates that PUT to an Application's `permissions` block is owner-gated: a viewer (or admin via bypass) sees the panel, but an unauthenticated transfer attempt by a viewer must be rejected. We do the happy-path transfer as admin (owner via bypass) and then assert that the orphan-check would reject an `owners = []` save.",
			"item": [
				{
					"name": "4.1 Admin transfers owners to editor group, viewer to old owner",
					"request": {
						"method": "PUT",
						"header": [
							{ "key": "Content-Type", "value": "application/json" }
						],
						"body": {
							"mode": "raw",
							"raw": "{{merged_body}}"
						},
						"url": {
							"raw": "{{base_url}}/index.php/apps/openregister/api/objects/buildiq/built-app/{{application_uuid}}",
							"host": ["{{base_url}}"],
							"path": ["index.php", "apps", "openregister", "api", "objects", "buildiq", "built-app", "{{application_uuid}}"]
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Same two fixes as 1.10: merge into the full record (OR's PUT is",
									"// not a PATCH and slug/name are required) and use `group:`-prefixed",
									"// principals, which is what PermissionResolver::matchesCaller()",
									"// classifies on.",
									"const base = JSON.parse(pm.collectionVariables.get('application_full') || '{}');",
									"const permissions = {",
									"    owners: ['group:' + pm.collectionVariables.get('editor_group')],",
									"    editors: [],",
									"    viewers: ['group:' + pm.collectionVariables.get('viewer_group')]",
									"};",
									"pm.collectionVariables.set('merged_body', JSON.stringify(Object.assign({}, base, { permissions: permissions })));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Ownership transfer succeeded', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "4.2 New owner (editor group user) can still read manifest",
