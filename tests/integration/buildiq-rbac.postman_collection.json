				{
					"name": "2.2b POSITIVE CONTROL — the outsider origin really acts as the outsider",
					"description": "Everything 2.3 and 3.1 conclude depends on the request being the OUTSIDER's. A per-request Basic override alone cannot achieve that (see the collection description: Nextcloud ignores Authorization once a session cookie exists), so this probe pins the acting identity BEFORE any RBAC conclusion is drawn from it. If this fails, 2.3 and 3.1 are measuring somebody else and their verdicts mean nothing — which is exactly the failure mode that made them red in CI while looking like an RBAC defect.",
					"request": {
						"auth": {
							"type": "basic",
							"basic": [
								{ "key": "username", "value": "{{outsider_user}}", "type": "string" },
								{ "key": "password", "value": "{{outsider_password}}", "type": "string" }
							]
						},
						"method": "GET",
						"header": [
							{ "key": "OCS-APIRequest", "value": "true" },
							{ "key": "Accept", "value": "application/json" }
						],
						"url": {
