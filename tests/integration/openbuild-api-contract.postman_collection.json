							{ "key": "OCS-APIRequest", "value": "true" }
						],
						"body": { "mode": "raw", "raw": "{\n  \"target\": \"not-a-real-target\",\n  \"applicationVersion\": \"1.0.0\"\n}" },
						"url": { "raw": "{{baseUrl}}/index.php/apps/openbuild/api/applications/{{appSlug}}/exports", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "openbuild", "api", "applications", "{{appSlug}}", "exports" ] }
					}
				},
