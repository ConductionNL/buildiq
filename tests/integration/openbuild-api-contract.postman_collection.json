						"url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/openbuild/application", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "openregister", "api", "objects", "openbuild", "application" ] }
					}
				},
				{
					"name": "OR read Application object (200)",
