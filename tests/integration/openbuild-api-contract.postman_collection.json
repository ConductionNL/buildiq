						"url": { "raw": "{{baseUrl}}/index.php/apps/openregister/api/objects/openbuild/application/{{crudAppUuid}}", "host": [ "{{baseUrl}}" ], "path": [ "index.php", "apps", "openregister", "api", "objects", "openbuild", "application", "{{crudAppUuid}}" ] }
