		{
			"name": "4. Virtual App + Schema CRUD (OpenRegister, ADR-022)",
			"description": "OpenBuild owns no Application-CRUD controller per ADR-022; Application + Schema objects are created/read/updated/deleted through the OpenRegister object API. This folder exercises create -> read -> update -> delete on an Application object in the shared 'openbuild' register / 'application' schema.",
			"item": [
				{
					"name": "OR create Application object (201/200)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('OR create -> 2xx', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
									"const body = pm.response.json();",
									"const uuid = (body['@self'] && body['@self'].id) || body.id || body.uuid;",
									"pm.test('created object has an id', () => pm.expect(uuid).to.be.a('string').and.to.have.length.above(10));",
									"pm.collectionVariables.set('crudAppUuid', uuid);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
