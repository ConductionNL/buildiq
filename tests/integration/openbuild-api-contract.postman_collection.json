									"// previously got 403; now an admin can export any application -> 202 + uuid.",
									"// (mirrors ApplicationsController REQ-OBRBAC-006 admin policy).",
									"// A non-admin who is in no role bucket still gets a clean 403.",
									"pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));",
									"// 202 carries { uuid }; assert it below.",
									"pm.test('export submit -> 202 Accepted', () => pm.response.to.have.status(202));",
										"pm.test('export submit returns a job uuid', () => pm.expect(pm.response.json().uuid).to.be.a('string').and.not.empty);",
									"pm.test('not a 500', () => pm.expect(pm.response.code).to.not.eql(500));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"auth": { "type": "basic", "basic": [ { "key": "username", "value": "{{adminUser}}", "type": "string" }, { "key": "password", "value": "{{adminPass}}", "type": "string" } ] },
